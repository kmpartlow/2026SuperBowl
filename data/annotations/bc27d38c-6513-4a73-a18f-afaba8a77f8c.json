      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\"Too loud, too reckless, too ghetto\"\nConditioning within white supremacy in America that Black people should be docile, quiet and grateful for what they get, not loud and aggressive as the common stereotype of Black culture"
            }
          ]
        }
      ],
