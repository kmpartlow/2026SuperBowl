      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "\"Forty acres and a mule, this is bigger than the music\"\nReference to the unrealized promise by the U.S. gov. to give formerly enslaved African Americans control, ownership, and freedom of their land and resources"
            }
          ]
        }
